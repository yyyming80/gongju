.page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 40rpx 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

.upload-area {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 3rpx dashed #ddd;
  margin-bottom: 30rpx;
}

.upload-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.hint {
  font-size: 24rpx;
  color: #ccc;
}

.file-section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.file-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.preview-img {
  width: 100%;
  max-height: 400rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.file-info {
  text-align: center;
}

.file-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.file-size {
  font-size: 24rpx;
  color: #999;
}

.clear-btn {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 40rpx;
  color: #ccc;
  padding: 10rpx 20rpx;
}

.format-section {
  margin-bottom: 30rpx;
}

.format-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.format-list {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.format-item {
  padding: 20rpx 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
}

.format-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-color: #667eea;
}

.convert-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  border-radius: 45rpx;
  line-height: 90rpx;
}

.result-section {
  margin-bottom: 30rpx;
}

.result-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.result-img {
  width: 100%;
  max-height: 400rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.result-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.action-btn {
  flex: 1;
  height: 70rpx;
  background-color: #f5f7fa;
  color: #333;
  font-size: 28rpx;
  border: none;
  border-radius: 35rpx;
  line-height: 70rpx;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.info-section {
  margin-top: 20rpx;
}

.info-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.info-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.info-item {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  line-height: 1.5;
}