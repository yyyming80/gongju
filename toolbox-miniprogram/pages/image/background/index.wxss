.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 40rpx 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

.upload-area {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 3rpx dashed #ddd;
  margin-bottom: 30rpx;
  min-height: 400rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #ccc;
}

.preview-image {
  max-width: 100%;
  max-height: 400rpx;
  border-radius: 12rpx;
}

.image-display-area {
  display: flex;
  gap: 30rpx;
  margin-bottom: 30rpx;
}

.image-section {
  flex: 1;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.section-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.color-section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.color-grid {
  display: flex;
  gap: 30rpx;
}

.color-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  border-radius: 12rpx;
  background-color: #f8f9fa;
}

.color-item.active {
  background-color: #e8f0fe;
  border: 2rpx solid #4385f5;
}

.color-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.color-name {
  font-size: 24rpx;
  color: #333;
}

.action-area {
  margin-top: 20rpx;
}

.process-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  border-radius: 45rpx;
  line-height: 90rpx;
}

.result-area {
  margin-top: 40rpx;
}

.result-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.result-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
}

.result-preview {
  width: 100%;
  max-height: 400rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.result-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  width: 240rpx;
  height: 70rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  border: none;
  border-radius: 35rpx;
  line-height: 70rpx;
}