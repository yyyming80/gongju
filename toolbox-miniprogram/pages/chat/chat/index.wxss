.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f7fa;
}

/* 聊天区域 */
.chat-area {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 20rpx;
}

/* 欢迎提示 */
.welcome-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.welcome-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.welcome-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.quick-questions {
  width: 100%;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.quick-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
}

.quick-item {
  background-color: #f0f2f5;
  padding: 20rpx 30rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #667eea;
}

.quick-item:last-child {
  margin-bottom: 0;
}

/* 消息列表 */
.message-list {
  display: flex;
  flex-direction: column;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.message-item.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.ai-avatar {
  background-color: #667eea;
}

.user-avatar {
  background-color: #13c2c2;
}

.message-content {
  max-width: 70%;
  margin: 0 16rpx;
}

.message-bubble {
  padding: 24rpx 30rpx;
  border-radius: 16rpx;
  word-break: break-all;
}

.message-bubble.ai {
  background-color: #fff;
  border-top-left-radius: 8rpx;
}

.message-bubble.user {
  background-color: #667eea;
  color: #fff;
  border-top-right-radius: 8rpx;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.message-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.message-item.user .message-time {
  text-align: right;
}

/* 加载指示器 */
.loading-indicator {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
}

.loading-dots {
  display: flex;
  margin-right: 16rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #667eea;
  margin: 0 4rpx;
  animation: bounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
.dot:nth-child(3) { animation-delay: 0s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 输入区域 */
.input-area {
  display: flex;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  border-top: 1rpx solid #eee;
  align-items: center;
}

.message-input {
  flex: 1;
  height: 80rpx;
  padding: 0 30rpx;
  background-color: #f5f7fa;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.send-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #e5e7eb;
  color: #999;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0;
  margin: 0;
}

.send-btn.active {
  background-color: #667eea;
  color: #fff;
}

.send-btn[disabled] {
  background-color: #e5e7eb;
  color: #999;
}