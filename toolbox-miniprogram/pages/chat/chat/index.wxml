<view class="container">
  <!-- 聊天消息区域 -->
  <scroll-view 
    class="chat-area" 
    scroll-y 
    scroll-top="{{scrollTop}}"
    bindscrolltoupper="onScrollTop">
    
    <!-- 欢迎消息 -->
    <view class="welcome-tip" wx:if="{{messages.length === 0}}">
      <view class="welcome-icon">🤖</view>
      <text class="welcome-title">AI智能客服</text>
      <text class="welcome-desc">我可以帮您解答平台使用问题</text>
      <view class="quick-questions">
        <text class="quick-title">常见问题：</text>
        <view class="quick-item" bindtap="sendQuickQuestion" data-question="如何使用PDF合并？">如何合并PDF？</view>
        <view class="quick-item" bindtap="sendQuickQuestion" data-question="如何使用图片压缩？">如何压缩图片？</view>
        <view class="quick-item" bindtap="sendQuickQuestion" data-question="如何使用图片换背景？">如何换背景？</view>
        <view class="quick-item" bindtap="sendQuickQuestion" data-question="如何拆分PDF？">如何拆分PDF？</view>
      </view>
    </view>

    <!-- 消息列表 -->
    <view class="message-list" wx:if="{{messages.length > 0}}">
      <view 
        wx:for="{{messages}}" 
        wx:key="index"
        class="message-item {{item.role === 'user' ? 'user' : 'ai'}}">
        
        <!-- AI头像 -->
        <view class="avatar ai-avatar" wx:if="{{item.role === 'ai'}}">🤖</view>
        
        <!-- 消息内容 -->
        <view class="message-content">
          <view class="message-bubble {{item.role}}">
            <text class="message-text">{{item.content}}</text>
          </view>
          <text class="message-time">{{item.time}}</text>
        </view>
        
        <!-- 用户头像 -->
        <view class="avatar user-avatar" wx:if="{{item.role === 'user'}}">👤</view>
      </view>
    </view>
  </scroll-view>

  <!-- 加载指示器 -->
  <view class="loading-indicator" wx:if="{{loading}}">
    <view class="loading-dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
    <text class="loading-text">AI正在回复...</text>
  </view>

  <!-- 输入区域 -->
  <view class="input-area">
    <input 
      class="message-input"
      type="text"
      placeholder="输入您的问题..."
      value="{{inputText}}"
      bindinput="onInput"
      bindconfirm="sendMessage"
      confirm-type="send"
      cursor-spacing="20"
    />
    <button 
      class="send-btn {{inputText.trim() ? 'active' : ''}}" 
      bindtap="sendMessage"
      disabled="{{!inputText.trim() || loading}}">
      发送
    </button>
  </view>
</view>