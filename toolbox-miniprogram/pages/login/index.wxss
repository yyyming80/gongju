.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 60rpx;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo-icon {
  font-size: 160rpx;
  margin-bottom: 30rpx;
}

.app-name {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 登录说明 */
.desc-section {
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 40rpx;
  width: 100%;
  margin-bottom: 60rpx;
}

.desc-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 30rpx;
  display: block;
  text-align: center;
}

.desc-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.desc-item:last-child {
  margin-bottom: 0;
}

.desc-icon {
  color: #4ade80;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #fff;
}

/* 登录按钮 */
.login-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  background-color: #fff;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
}

.login-btn:active {
  transform: scale(0.98);
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.guest-btn {
  width: 100%;
  height: 88rpx;
  background-color: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-text-guest {
  font-size: 28rpx;
  color: #fff;
}

.guest-btn:active {
  background-color: rgba(255, 255, 255, 0.1);
}

/* 协议 */
.agreement-section {
  position: fixed;
  bottom: 60rpx;
  left: 30rpx;
  right: 30rpx;
  text-align: center;
}

.agreement-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.link {
  color: #fff;
  text-decoration: underline;
}

/* 加载提示 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  background-color: #fff;
  padding: 60rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}