<view class="page">
  <view class="header">
    <text class="title">PDF拆分</text>
    <text class="subtitle">将PDF按页码拆分为多个文件</text>
  </view>

  <view class="upload-area" wx:if="{{!fileName}}" bindtap="chooseFile">
    <view class="upload-content">
      <text class="icon">📄</text>
      <text class="text">点击选择PDF文件</text>
      <text class="hint">支持PDF格式</text>
    </view>
  </view>

  <view class="file-section" wx:if="{{fileName}}">
    <view class="file-card">
      <view class="file-icon">📄</view>
      <view class="file-info">
        <text class="file-name">{{fileName}}</text>
        <text class="file-size">页数: {{pageCount}}</text>
      </view>
      <text class="clear-btn" bindtap="clearFile">×</text>
    </view>

    <view class="range-section">
      <text class="range-title">输入页码范围（可选）</text>
      <input class="range-input" placeholder="如: 1,3,5 或 1-3" value="{{pageRange}}" bindinput="onPageRangeInput" />
      <text class="range-hint">留空则拆分所有页面</text>
    </view>

    <button class="split-btn" bindtap="splitPdf" loading="{{loading}}">
      {{loading ? '拆分中...' : '开始拆分'}}
    </button>
  </view>

  <view class="result-section" wx:if="{{resultFiles.length > 0}}">
    <view class="result-header">
      <text class="result-title">拆分结果</text>
      <text class="result-count">共{{resultFiles.length}}个文件</text>
    </view>

    <view class="result-list">
      <view class="result-item" wx:for="{{resultFiles}}" wx:key="index">
        <view class="item-info">
          <text class="item-name">{{item.fileName}}</text>
          <text class="item-page" wx:if="{{item.page}}">第{{item.page}}页</text>
          <text class="item-page" wx:if="{{item.pages}}">页码: {{item.pages}}</text>
        </view>
        <view class="item-actions">
          <button class="action-btn preview" bindtap="previewPdf" data-url="{{item.fileUrl}}">预览</button>
        </view>
      </view>
    </view>
  </view>

  <view class="info-section">
    <view class="info-card">
      <text class="info-title">使用说明</text>
      <view class="info-item">1. 点击上方选择PDF文件</view>
      <view class="info-item">2. 输入要拆分的页码范围（可选）</view>
      <view class="info-item">3. 格式示例：1,3,5 或 1-3</view>
      <view class="info-item">4. 点击"开始拆分"按钮</view>
    </view>
  </view>
</view>