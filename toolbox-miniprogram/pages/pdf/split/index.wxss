.page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 40rpx 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

.upload-area {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 3rpx dashed #ddd;
  margin-bottom: 30rpx;
}

.upload-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-area .icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.upload-area .text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.upload-area .hint {
  font-size: 24rpx;
  color: #ccc;
}

.file-section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.file-card {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.file-icon {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.file-info {
  flex: 1;
}

.file-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.file-size {
  font-size: 24rpx;
  color: #999;
}

.clear-btn {
  font-size: 40rpx;
  color: #ccc;
  padding: 10rpx 20rpx;
}

.range-section {
  margin-bottom: 30rpx;
}

.range-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.range-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.range-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.split-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  border-radius: 45rpx;
  line-height: 90rpx;
}

.result-section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.result-count {
  font-size: 24rpx;
  color: #666;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
}

.item-info {
  flex: 1;
}

.item-name {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.item-page {
  font-size: 24rpx;
  color: #666;
}

.item-actions {
  display: flex;
  gap: 10rpx;
}

.action-btn {
  padding: 10rpx 30rpx;
  font-size: 24rpx;
  border: none;
  border-radius: 20rpx;
}

.action-btn.preview {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.info-section {
  margin-top: 20rpx;
}

.info-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.info-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.info-item {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  line-height: 1.5;
}