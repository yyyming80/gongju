/* pages/pdf/image2pdf/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 40rpx 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

.upload-area {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 3rpx dashed #ddd;
  margin-bottom: 30rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #ccc;
}

.image-list {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.list-count {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.header-actions {
  display: flex;
  gap: 20rpx;
}

.add-more {
  font-size: 26rpx;
  color: #4385f5;
}

.clear-btn {
  font-size: 26rpx;
  color: #ff4b4b;
}

.image-scroll {
  max-height: 600rpx;
}

.image-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}

.image-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f0f0f0;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.image-index {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.image-actions {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  background-color: rgba(0, 0, 0, 0.5);
  padding: 8rpx 0;
}

.action-btn {
  font-size: 28rpx;
  color: #fff;
  padding: 0 10rpx;
}

.action-btn.up,
.action-btn.down {
  font-size: 32rpx;
}

.action-btn.delete {
  font-size: 36rpx;
  color: #ff4b4b;
}

.convert-area {
  margin-bottom: 30rpx;
}

.convert-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  border-radius: 45rpx;
  line-height: 90rpx;
}

.result-area {
  margin-top: 20rpx;
}

.result-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.result-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.result-info {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.result-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.result-actions .action-btn {
  flex: 1;
  height: 70rpx;
  font-size: 28rpx;
  border: none;
  border-radius: 35rpx;
  line-height: 70rpx;
}

.result-actions .primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.result-actions .secondary {
  background-color: #f0f0f0;
  color: #333;
}