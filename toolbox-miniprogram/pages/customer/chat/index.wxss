.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.chat-header {
  height: 88rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #eee;
}

.header-left, .header-right {
  width: 80rpx;
}

.back-icon, .more-icon {
  font-size: 48rpx;
  color: #333;
}

.header-title {
  flex: 1;
  text-align: center;
}

.header-title text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.message-list {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.message-wrapper {
  margin-bottom: 40rpx;
}

.message {
  display: flex;
  align-items: flex-start;
}

.message.user {
  flex-direction: row-reverse;
}

.message.system {
  justify-content: center;
}

.system-text {
  font-size: 24rpx;
  color: #999;
  background: #f0f0f0;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  background: #667eea;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  flex-shrink: 0;
}

.message-content {
  max-width: 70%;
  margin: 0 20rpx;
}

.content-text {
  display: block;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.message.ai .content-text {
  background: #fff;
  color: #333;
}

.message.user .content-text {
  background: #667eea;
  color: #fff;
}

.time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
  text-align: right;
}

.message.user .time {
  text-align: left;
}

.transfer-hint {
  text-align: center;
  padding: 30rpx;
  margin: 20rpx 0;
}

.transfer-hint text {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}

.transfer-btn {
  display: inline-block;
  padding: 16rpx 40rpx;
  background: #fff;
  border: 2rpx solid #667eea;
  border-radius: 40rpx;
  color: #667eea;
  font-size: 28rpx;
}

.input-area {
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  border-top: 1rpx solid #eee;
}

.message-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  background: #667eea;
  border-radius: 36rpx;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}